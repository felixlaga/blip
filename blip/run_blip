def parse_prior_bounds(config,option,default):
    '''
    Parse a two-element prior interval from the optional [priors] section.
    '''
    if config.has_section('priors') and config.has_option('priors', option):
        bounds = eval(str(config.get('priors', option)))
    else:
        bounds = default
    if len(bounds) != 2:
        raise ValueError("Prior '{}' must have exactly two bounds.".format(option))
    bounds = [float(bounds[0]), float(bounds[1])]
    bounds.sort()
    return bounds


def format_prior_bounds_summary(prior_bounds):
    '''
    Format a compact one-line summary of parsed prior intervals.
    '''
    ordered_keys = ['log_Np','log_Na','alpha','log_A_L','log_omega0',
                    'log_A_ratio','alpha1','alpha2','log_fbreak','log_fcut','log_fscale']
    parts = []
    for key in ordered_keys:
        if key in prior_bounds:
            bounds = [float(prior_bounds[key][0]), float(prior_bounds[key][1])]
            parts.append("{}={}".format(key, bounds))
    return ', '.join(parts)


def parse_int_list(config, section, option, fallback=None):
    '''
    Parse a config option containing a list/tuple of integers.
    '''
    if not config.has_section(section) or not config.has_option(section, option):
        return fallback
    values = eval(str(config.get(section, option)))
    if isinstance(values, (int, np.integer)):
        values = [int(values)]
    else:
        values = [int(value) for value in values]
    return values


def parse_numeric_sequence(config, section, option, fallback=None):
    '''
    Parse a config option containing either a scalar or a list/tuple of floats.
    '''
    if not config.has_section(section) or not config.has_option(section, option):
        return fallback
    values = eval(str(config.get(section, option)))
    if isinstance(values, (int, float, np.integer, np.floating)):
        return float(values)
    return [float(value) for value in values]


